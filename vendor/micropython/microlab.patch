+#if MICROLAB_FRAMES
+#include "py/bc.h"
+#include "py/objfun.h"
+
+// MicroLab: where the program is, for the line marker (screen 03) and errors. Depth 0 is the innermost running
+// Python frame, 1 its caller, and so on. Returns the frame's source line and sets *file to its source file
+// (a qstr's C string), or returns 0 when there is no frame that deep. Read while the program waits in a call
+// into JavaScript (time.sleep) or in the VM hook, when every frame in the chain is alive.
+static mp_code_state_t *microlab_frame_at(size_t depth) {
+    mp_code_state_t *cs = MP_STATE_THREAD(current_code_state);
+    while (cs != NULL && depth-- > 0) {
+        cs = cs->prev_state;
+    }
+    return cs;
+}
+
+EMSCRIPTEN_KEEPALIVE size_t microlab_frame_line(size_t depth) {
+    mp_code_state_t *cs = microlab_frame_at(depth);
+    if (cs == NULL) {
+        return 0;
+    }
+    const byte *ip = cs->fun_bc->bytecode;
+    MP_BC_PRELUDE_SIG_DECODE(ip);
+    MP_BC_PRELUDE_SIZE_DECODE(ip);
+    const byte *line_info_top = ip + n_info;
+    const byte *bytecode_start = ip + n_info + n_cell;
+    size_t bc = cs->ip - bytecode_start;
+    ip = mp_decode_uint_skip(ip);   // the block name
+    for (size_t i = 0; i < n_pos_args + n_kwonly_args; ++i) {
+        ip = mp_decode_uint_skip(ip);
+    }
+    return mp_bytecode_get_source_line(ip, line_info_top, bc);
+}
+
+EMSCRIPTEN_KEEPALIVE const char *microlab_frame_file(size_t depth) {
+    mp_code_state_t *cs = microlab_frame_at(depth);
+    if (cs == NULL) {
+        return "";
+    }
+    #if MICROPY_EMIT_BYTECODE_USES_QSTR_TABLE
+    return qstr_str(cs->fun_bc->context->constants.qstr_table[0]);
+    #else
+    return qstr_str(cs->fun_bc->context->constants.source_file);
+    #endif
+}
+#endif
