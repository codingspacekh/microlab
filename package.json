{
  "name": "microlab",
  "productName": "MicroLab",
  "version": "0.12.0",
  "private": true,
  "description": "Build breadboard circuits, write MicroPython and simulate them — micro:bit, Pico W, ESP32",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --project unit --project python --project integration --project acceptance --project component --project python3",
    "e2e": "npm run build && playwright test",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run perf && npm run build",
    "fetch:python": "node scripts/fetch-python.mjs",
    "icon": "node scripts/make-icon.mjs",
    "package": "node scripts/package.ts",
    "dist": "npm run build && node scripts/package.ts",
    "release:mac": "node scripts/release-mac.ts",
    "spike:node": "node spikes/micropython-worker/node-spike.mjs",
    "spike:electron": "electron spikes/micropython-worker/electron-main.mjs",
    "pins": "node scripts/print-pins.mjs",
    "art": "python3 scripts/export-art.py",
    "perf": "vitest run --project perf --reporter=verbose --silent=false",
    "golden": "node scripts/record-golden.mjs",
    "examples": "node scripts/pack-examples.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "fflate": "^0.8.3",
    "serialport": "^13.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/cascadia-code": "^5.3.0",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/inconsolata": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-mono": "^5.3.0",
    "@fontsource-variable/red-hat-mono": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@fontsource-variable/source-code-pro": "^5.3.1",
    "@fontsource/anonymous-pro": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@micropython/micropython-webassembly-pyscript": "1.29.0-6",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "electron": "45.2.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "6.0.0",
    "eslint": "^10.14.0",
    "js-yaml": "^5.5.0",
    "jsdom": "^30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "5.1.0"
  }
}
